{% extends 'front/base.html.twig' %}

{% block title %}Suivi de l'Humeur{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <style>
        :root {
            --bg-primary: #324b74ff;
            --text-primary: #1A1F36;
            --text-secondary: #64748b;
            --primary-blue: #324b74ff;
            --color-steel-blue: #324b74ff;
            --color-accent-red: #d52e28;
            --primary-gradient: linear-gradient(135deg, #102c59 0%, #1a3c78 100%);
            --accent-gradient: linear-gradient(135deg, #d52e28 0%, #a0231e 100%);
            --card-bg: rgba(255, 255, 255, 0.98);
            --shadow: 0 4px 20px rgba(50, 75, 116, 0.12);
            --shadow-hover: 0 8px 30px rgba(50, 75, 116, 0.2);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: radial-gradient(circle at top right, rgba(213, 46, 40, 0.08), transparent),
                        radial-gradient(circle at bottom left, rgba(16, 44, 89, 0.25), transparent),
                        var(--bg-primary);
            color: var(--text-primary);
            min-height: 100vh;
            padding: 2rem 1rem;
        }

        /* Hero Header Section */
        .hero-header {
            text-align: center;
            margin-bottom: 3rem;
            padding: 2rem 0;
        }

        .greeting {
            font-size: 0.9rem;
            color: white;
            font-weight: 500;
            margin-bottom: 0.5rem;
        }

        .hero-title {
            font-size: 2.5rem;
            font-weight: 700;
            color: white;
            margin-bottom: 0.5rem;
        }

        .hero-date {
            font-size: 0.95rem;
            color: rgba(255, 255, 255, 0.8);
            margin-bottom: 2rem;
        }

        .primary-action-btn {
            background: var(--accent-gradient);
            color: white;
            border: none;
            padding: 1rem 2.5rem;
            font-size: 1rem;
            font-weight: 600;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(213, 46, 40, 0.3);
        }

        .primary-action-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(213, 46, 40, 0.5);
        }

        /* Main Container */
        .main-container {
            max-width: 1200px;
            margin: 0 auto;
        }

        /* 3-Column Grid */
        .dashboard-grid {
            display: grid;
            grid-template-columns: 25% 1fr;
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        /* Card Styles */
        .card {
            background: var(--card-bg);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(50, 75, 116, 0.1);
            border-radius: 16px;
            padding: 1.5rem;
            box-shadow: var(--shadow);
            transition: all 0.3s ease;
        }

        .card:hover {
            box-shadow: var(--shadow-hover);
        }

        .card-title {
            font-size: 0.85rem;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 1rem;
            font-weight: 600;
        }

        /* Sidebar Cards */
        .sidebar {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .mood-pill {
            display: inline-block;
            padding: 0.5rem 1.5rem;
            border-radius: 50px;
            font-size: 0.9rem;
            font-weight: 600;
            margin: 0.5rem 0;
        }

        .average-value {
            font-size: 2rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0.5rem 0;
        }

        .entry-count {
            font-size: 0.85rem;
            color: var(--text-secondary);
        }

        .streak-icon {
            font-size: 3rem;
            text-align: center;
            margin: 1rem 0;
        }

        .streak-value {
            font-size: 2rem;
            font-weight: 700;
            color: var(--text-primary);
            text-align: center;
        }

        .streak-label {
            font-size: 0.85rem;
            color: var(--text-secondary);
            text-align: center;
        }

        /* Main Content Area */
        .main-content {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .content-row {
            display: grid;
            grid-template-columns: 60% 40%;
            gap: 1.5rem;
        }

        /* Today's Mood Card */
        .todays-mood-card {
            position: relative;
            padding: 2rem;
            min-height: 200px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .mood-emoji-large {
            position: absolute;
            right: 2rem;
            top: 50%;
            transform: translateY(-50%);
            font-size: 6rem;
            filter: drop-shadow(0 4px 10px rgba(0,0,0,0.1));
        }

        .mood-content {
            max-width: 60%;
        }

        .mood-label-large {
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 1rem;
        }

        .mood-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        .mood-tag {
            background: rgba(50, 75, 116, 0.15);
            color: var(--color-steel-blue);
            padding: 0.4rem 1rem;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 500;
        }

        /* Sleep & Reflection Cards */
        .info-cards {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .info-card {
            flex: 1;
        }

        .info-value {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0.5rem 0;
        }

        /* Trend Chart */
        .trend-chart-card {
            padding: 2rem;
        }

        .chart-container {
            margin-top: 2rem;
            position: relative;
            height: 300px;
        }

        .chart-bars {
            display: flex;
            align-items: flex-end;
            justify-content: space-around;
            height: 100%;
            gap: 0.5rem;
        }

        .chart-bar-wrapper {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.5rem;
        }

        .chart-bar {
            width: 100%;
            max-width: 40px;
            background: linear-gradient(180deg, var(--bar-color) 0%, var(--bar-color-light) 100%);
            border-radius: 8px 8px 0 0;
            transition: all 0.5s ease;
            animation: barGrow 0.8s ease forwards;
        }

        @keyframes barGrow {
            from {
                height: 0;
            }
            to {
                height: var(--bar-height);
            }
        }

        .chart-label {
            font-size: 0.75rem;
            color: var(--text-secondary);
            text-align: center;
        }

        .empty-state {
            text-align: center;
            padding: 3rem;
            color: var(--text-secondary);
        }

        .empty-state-icon {
            font-size: 4rem;
            margin-bottom: 1rem;
            opacity: 0.3;
        }

        /* Modal Styles */
        .modal-overlay {
            display: none !important;
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            right: 0 !important;
            bottom: 0 !important;
            background: rgba(26, 31, 54, 0.9) !important;
            backdrop-filter: blur(4px);
            z-index: 999999 !important;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .modal-overlay.active {
            display: flex !important;
            opacity: 1 !important;
        }

        .modal {
            background: var(--card-bg);
            width: 90%;
            max-width: 500px;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            transform: scale(0.9);
            transition: transform 0.3s ease;
            position: relative;
            z-index: 10000;
        }

        .modal-overlay.active .modal {
            transform: scale(1);
        }

        .modal-header {
            padding: 1.5rem;
            border-bottom: 1px solid rgba(143, 149, 178, 0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .modal-close {
            background: none;
            border: none;
            font-size: 1.5rem;
            color: var(--text-secondary);
            cursor: pointer;
            transition: color 0.2s;
        }

        .modal-close:hover {
            color: var(--text-primary);
        }

        .progress-bar {
            height: 4px;
            background: rgba(50, 75, 116, 0.15);
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            background: var(--primary-gradient);
            transition: width 0.3s ease;
        }

        .modal-body {
            padding: 2rem;
            max-height: 60vh;
            overflow-y: auto;
        }

        .step {
            display: none;
        }

        .step.active {
            display: block;
            animation: fadeIn 0.3s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .step-title {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 1.5rem;
            color: var(--text-primary);
        }

        /* Mood Selection (Step 1) */
        .mood-options {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .mood-option {
            background: var(--card-bg);
            border: 2px solid rgba(143, 149, 178, 0.2);
            border-radius: 12px;
            padding: 1rem 1.5rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .mood-option:hover {
            border-color: var(--primary-blue);
            transform: translateX(4px);
        }

        .mood-option.selected {
            border-color: var(--color-steel-blue);
            background: rgba(50, 75, 116, 0.1);
            position: relative;
        }

        .mood-option.selected::after {
            content: "✓";
            position: absolute;
            right: 1.5rem;
            color: var(--color-steel-blue);
            font-weight: 700;
            font-size: 1.2rem;
        }

        .mood-emoji {
            font-size: 2rem;
        }

        .mood-text {
            flex: 1;
        }

        .mood-name {
            font-weight: 600;
            font-size: 1.1rem;
        }

        /* Tags Selection (Step 2) */
        .tags-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
        }

        .tag-option {
            background: var(--card-bg);
            border: 2px solid rgba(143, 149, 178, 0.2);
            border-radius: 25px;
            padding: 0.75rem 1.5rem;
            cursor: pointer;
            transition: all 0.2s ease;
            font-weight: 500;
        }

        .tag-option:hover {
            border-color: var(--color-steel-blue);
        }

        .tag-option.selected {
            border-color: var(--color-steel-blue);
            background: var(--primary-gradient);
            color: white;
        }

        /* Journal (Step 3) */
        .journal-textarea {
            width: 100%;
            min-height: 150px;
            padding: 1rem;
            border: 2px solid rgba(143, 149, 178, 0.2);
            border-radius: 12px;
            font-family: 'Inter', sans-serif;
            font-size: 0.95rem;
            resize: vertical;
            transition: border-color 0.2s;
        }

        .journal-textarea:focus {
            outline: none;
            border-color: var(--color-steel-blue);
        }

        .journal-textarea.error {
            border-color: #FF6B6B;
        }

        .char-count {
            text-align: right;
            font-size: 0.85rem;
            color: var(--text-secondary);
            margin-top: 0.5rem;
        }

        .char-count.error {
            color: #FF6B6B;
        }

        .error-message {
            color: #FF6B6B;
            font-size: 0.85rem;
            margin-top: 0.5rem;
        }

        /* Sleep Selection (Step 4) */
        .sleep-options {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .sleep-option {
            background: var(--card-bg);
            border: 2px solid rgba(143, 149, 178, 0.2);
            border-radius: 12px;
            padding: 1rem 1.5rem;
            cursor: pointer;
            transition: all 0.2s ease;
            text-align: center;
            font-weight: 500;
        }

        .sleep-option:hover {
            border-color: var(--primary-blue);
        }

        .sleep-option.selected {
            border-color: var(--color-steel-blue);
            background: rgba(50, 75, 116, 0.1);
        }

        /* Modal Footer */
        .modal-footer {
            padding: 1.5rem;
            border-top: 1px solid rgba(143, 149, 178, 0.1);
            display: flex;
            gap: 1rem;
        }

        .btn {
            flex: 1;
            padding: 0.875rem 2rem;
            border: none;
            border-radius: 12px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-secondary {
            background: rgba(143, 149, 178, 0.1);
            color: var(--text-primary);
        }

        .btn-secondary:hover {
            background: rgba(143, 149, 178, 0.2);
        }

        .btn-primary {
            background: var(--primary-gradient);
            color: white;
        }

        .btn-primary:hover:not(:disabled) {
            background: var(--accent-gradient);
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(50, 75, 116, 0.3);
        }

        .btn-primary:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        /* Responsive */
        @media (max-width: 968px) {
            .dashboard-grid {
                grid-template-columns: 1fr;
            }

            .content-row {
                grid-template-columns: 1fr;
            }

            .mood-content {
                max-width: 100%;
                margin-bottom: 4rem;
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="main-container">
    <!-- Hero Header -->
    <div class="hero-header">
        <div class="greeting">Bonjour {{ userName }}!</div>
        <h1 class="hero-title">Comment vous sentez-vous aujourd'hui?</h1>
        <div class="hero-date">{{ "now"|date("l d F Y") }}</div>
        <button onclick="openMoodModal()" class="primary-action-btn">
            {{ todayMood ? 'Modifier l\'humeur du jour' : 'Enregistrer l\'humeur du jour' }}
        </button>
    </div>

    <!-- Dashboard Grid -->
    <div class="dashboard-grid">
        <!-- Sidebar -->
        <div class="sidebar">
            <!-- Average Mood Card -->
            <div class="card">
                <div class="card-title">Humeur Moyenne</div>
                {% if averageMood %}
                    <div class="mood-pill" style="background: {{ moodColors[averageMood] }}20; color: {{ moodColors[averageMood] }};">
                        {{ moodLabels[averageMood] }}
                    </div>
                    <div class="entry-count">Basé sur les 7 derniers jours</div>
                {% else %}
                    <div class="entry-count">Aucune donnée disponible</div>
                {% endif %}
            </div>

            <!-- Longest Streak Card -->
            <div class="card">
                <div class="card-title">Meilleure Série</div>
                <div class="streak-icon">🔥</div>
                <div class="streak-value">{{ longestStreak }}</div>
                <div class="streak-label">jours consécutifs</div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            <!-- Top Row: Today's Mood & Sleep -->
            <div class="content-row">
                <!-- Today's Mood -->
                <div class="card todays-mood-card" id="todaysMoodCard">
                    {% if todayMood %}
                        <div class="mood-emoji-large">{{ moodEmojis[todayMood.valeurHumeur] }}</div>
                        <div class="mood-content">
                            <div class="mood-label-large">Je me sens {{ moodLabels[todayMood.valeurHumeur] }}</div>
                            {% if todayMood.tendance %}
                                <div class="mood-tags" id="displayTags">
                                    {% for tag in todayMood.tendance|split(',') %}
                                        {% if tag %}
                                            <span class="mood-tag">{{ tag }}</span>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>
                    {% else %}
                        <div class="empty-state">
                            <div class="empty-state-icon">😊</div>
                            <p>Enregistrez votre première humeur!</p>
                        </div>
                    {% endif %}
                </div>

                <!-- Info Cards -->
                <div class="info-cards">
                    <div class="card info-card">
                        <div class="card-title">Sommeil</div>
                        <div class="info-value" id="sleepDisplay">
                            {% if todayMood %}7-8 heures{% else %}Non enregistré{% endif %}
                        </div>
                    </div>
                    <div class="card info-card">
                        <div class="card-title">Réflexion du jour</div>
                        <div style="font-size: 0.9rem; line-height: 1.6; color: var(--text-secondary);" id="journalDisplay">
                            {% if todayMood and todayMood.facteurPrincipal %}
                                {{ todayMood.facteurPrincipal }}
                            {% else %}
                                Aucune réflexion
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>

            <!-- Trend Chart -->
            <div class="card trend-chart-card">
                <div class="card-title">Tendances de l'humeur et du sommeil</div>
                <div class="chart-container" style="height: 350px; padding: 20px;">
                    {% if moods is not empty %}
                        <canvas id="moodChart"></canvas>
                    {% else %}
                        <div class="empty-state">
                            <div class="empty-state-icon">📊</div>
                            <p>Aucune donnée de tendance disponible. Commencez à enregistrer votre humeur!</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

{% include 'front/partials/_mood_tracker_content.html.twig' %}

{% endblock %}

