{% extends 'back/basem.html.twig' %}

{% block title %}Dashboard - Back Office{% endblock %}

{% block body %}
<div class="page-title light-background">
    <div class="container d-lg-flex justify-content-between align-items-center">
        <h1 class="mb-2 mb-lg-0 text-primary">Dashboard</h1>
        <nav class="breadcrumbs">
            <ol>
                <li class="current">Accueil</li>
            </ol>
        </nav>
    </div>
</div>

<section class="section">
    <div class="container">

        {# Stat cards #}
        <div class="row g-4 mb-5">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm text-center p-4">
                    <i class="bi bi-journal-text fs-1 text-primary mb-2"></i>
                    <h2 class="fw-bold">{{ stats.total_articles }}</h2>
                    <p class="text-muted mb-0">Articles</p>
                    <small class="text-success">{{ stats.articles_publies }} publiés</small>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm text-center p-4">
                    <i class="bi bi-list-check fs-1 text-warning mb-2"></i>
                    <h2 class="fw-bold">{{ stats.total_plans }}</h2>
                    <p class="text-muted mb-0">Plans d'actions</p>
                    <small class="text-info">{{ plans_par_statut.en_cours }} en cours</small>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm text-center p-4">
                    <i class="bi bi-robot fs-1 text-success mb-2"></i>
                    <h2 class="fw-bold">{{ stats.total_sorties }}</h2>
                    <p class="text-muted mb-0">Sorties IA</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm text-center p-4">
                    <i class="bi bi-tags fs-1 text-danger mb-2"></i>
                    <h2 class="fw-bold">{{ stats.total_categories }}</h2>
                    <p class="text-muted mb-0">Catégories</p>
                </div>
            </div>
        </div>

        <div class="row g-4">
            {# Plans par statut #}
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-transparent border-0 fw-bold">
                        <i class="bi bi-bar-chart me-1"></i> Plans par statut
                    </div>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between">
                            <span><i class="bi bi-clock text-warning me-1"></i> En attente</span>
                            <span class="badge bg-warning text-dark">{{ plans_par_statut.en_attente }}</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span><i class="bi bi-arrow-repeat text-info me-1"></i> En cours</span>
                            <span class="badge bg-info">{{ plans_par_statut.en_cours }}</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span><i class="bi bi-check-circle text-success me-1"></i> Terminés</span>
                            <span class="badge bg-success">{{ plans_par_statut.fini }}</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span><i class="bi bi-x-circle text-danger me-1"></i> Rejetés</span>
                            <span class="badge bg-danger">{{ plans_par_statut.rejete }}</span>
                        </li>
                    </ul>
                </div>
            </div>

            {# Derniers articles #}
            <div class="col-md-8">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                        <span class="fw-bold"><i class="bi bi-journal me-1"></i> Derniers articles</span>
                        <a href="{{ path('app_reference_article_index') }}" class="btn btn-sm btn-outline-primary">Voir tout</a>
                    </div>
                    <div class="card-body p-0">
                        {% if derniers_articles %}
                        <ul class="list-group list-group-flush">
                            {% for article in derniers_articles %}
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span class="text-truncate" style="max-width: 300px;">{{ article.titre ?? article.title ?? 'Article' }}</span>
                                <span class="badge {{ article.published ?? false ? 'bg-success' : 'bg-secondary' }}">
                                    {{ article.published ?? false ? 'Publié' : 'Brouillon' }}
                                </span>
                            </li>
                            {% endfor %}
                        </ul>
                        {% else %}
                        <p class="text-muted text-center py-3">Aucun article pour l'instant.</p>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        {# Derniers plans #}
        <div class="row g-4 mt-2">
            <div class="col-md-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                        <span class="fw-bold"><i class="bi bi-list-check me-1"></i> Derniers plans</span>
                        <a href="{{ path('app_plan_actions_index') }}" class="btn btn-sm btn-outline-warning">Voir tout</a>
                    </div>
                    <div class="card-body p-0">
                        {% if derniers_plans %}
                        <ul class="list-group list-group-flush">
                            {% for plan in derniers_plans %}
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span class="text-truncate" style="max-width: 250px;">{{ plan.titre ?? plan.title ?? 'Plan' }}</span>
                                <span class="badge bg-secondary">{{ plan.statut }}</span>
                            </li>
                            {% endfor %}
                        </ul>
                        {% else %}
                        <p class="text-muted text-center py-3">Aucun plan pour l'instant.</p>
                        {% endif %}
                    </div>
                </div>
            </div>

            {# Dernières sorties IA #}
            <div class="col-md-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                        <span class="fw-bold"><i class="bi bi-robot me-1"></i> Dernières sorties IA</span>
                        <a href="{{ path('app_sortie_ai_index') }}" class="btn btn-sm btn-outline-success">Voir tout</a>
                    </div>
                    <div class="card-body p-0">
                        {% if dernieres_sorties %}
                        <ul class="list-group list-group-flush">
                            {% for sortie in dernieres_sorties %}
                            <li class="list-group-item">
                                <span class="text-truncate d-block" style="max-width: 300px;">{{ sortie.titre ?? sortie.title ?? 'Sortie IA' }}</span>
                            </li>
                            {% endfor %}
                        </ul>
                        {% else %}
                        <p class="text-muted text-center py-3">Aucune sortie IA pour l'instant.</p>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>
{% endblock %}
